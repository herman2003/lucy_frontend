rules_version = '2';

// Centralization (C-OPS): Flutter has no Firestore SDK — Nest Admin SDK is the sole
// reader/writer for users/{uid}. Deny all client access; deploy after C-F3.
// Deploy: firebase deploy --only firestore:rules --project lucy-7504c
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if false;
    }
  }
}
